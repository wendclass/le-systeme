# ==============================================================================
# LE SYSTÈME · CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (S7)
# ==============================================================================
# Domaine de production : https://lesysteme.wendclass.com
# URL de redirection Google OAuth en production : https://lesysteme.wendclass.com/auth/callback
# URL de redirection Google OAuth en local : http://localhost:5173/auth/callback (ou http://localhost:3000/auth/callback)
# ==============================================================================

# Domaines & Administrateur
APP_BASE_URL=https://lesysteme.wendclass.com
SITE_BASE_URL=https://wendclass.com
SUPER_ADMIN_EMAIL=wendclasss@gmail.com

# Identifiants Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Base de données Supabase (partagée avec le site wendclass.com selon Option A)
DB_URL=
DB_PUBLIC_KEY=
DB_SERVICE_KEY=

# Sécurité des liens clients (/c/[token])
CLIENT_LINK_SECRET=

# Stockage et Drive (si applicable)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Mappings Vite côté navigateur (Single Page Application)
VITE_APP_BASE_URL=https://lesysteme.wendclass.com
VITE_SITE_BASE_URL=https://wendclass.com
VITE_SUPER_ADMIN_EMAIL=wendclasss@gmail.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CURRENCY_API_URL=
